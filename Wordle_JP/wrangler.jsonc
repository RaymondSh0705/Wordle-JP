{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "wordle-jp",
    "main": "worker/index.js",
    "compatibility_date": "2026-10-03",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    }
}